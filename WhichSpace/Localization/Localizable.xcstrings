    "detail_copy_to_all_displays" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحدّث هذا جميع المساحات على جميع الشاشات لتطابق لون هذه المساحة ونمطها ورمزها وخطها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще обнови всички Пространства на всички дисплеи да съвпадат с цвета, стила, символа и шрифта на това Пространство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això actualitzarà tots els Espais de totes les pantalles per coincidir amb el color, l'estil, el símbol i el tipus de lletra d'aquest Espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje všechny Spaces na všech displejích, aby odpovídaly barvě, stylu, symbolu a písmu tohoto Space."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette opdaterer alle Spaces på alle skærme, så de matcher farven, stilen, symbolet og skrifttypen for dette Space."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies aktualisiert alle Spaces auf allen Displays auf die Farbe, den Stil, das Symbol und die Schriftart dieses Spaces."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα ενημερώσει όλους τους Χώρους σε όλες τις οθόνες ώστε να ταιριάζουν με το χρώμα, το στιλ, το σύμβολο και τη γραμματοσειρά αυτού του Χώρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will update all Spaces on all Displays to match this Space's color, style, symbol, and font."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will update all Spaces on all Displays to match this Space's colour, style, symbol, and font."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto actualizará todos los Espacios de todas las pantallas para que coincidan con el color, estilo, símbolo y fuente de este Espacio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار همه فضاها در همه نمایشگرها را با رنگ، استایل، نماد و فونت این فضا هماهنگ می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä päivittää kaikkien näyttöjen kaikki Spacet vastaamaan tämän Spacen väriä, tyyliä, symbolia ja fonttia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela mettra à jour tous les Espaces de tous les écrans pour qu'ils correspondent à la couleur, au style, au symbole et à la police de cet Espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה יעדכן את כל המרחבים בכל התצוגות כך שיתאימו לצבע, לסגנון, לסמל ולגופן של מרחב זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सभी डिस्प्ले के सभी स्पेसेस को इस स्पेस के रंग, स्टाइल, प्रतीक और फ़ॉन्ट से मिलाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez frissíti az összes Space-t minden kijelzőn, hogy megegyezzen ennek a Space-nek a színével, stílusával, szimbólumával és betűtípusával."
          }
        },
        "id" : {
          "stringUnit" : {
