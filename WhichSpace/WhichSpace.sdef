<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="WhichSpace Terminology">
    <suite name="WhichSpace Suite" code="WSpc" description="WhichSpace specific classes and commands.">
        <command name="count" code="corecnte" description="Return the number of elements of a particular class within an object.">
            <cocoa class="NSCountCommand"/>
            <direct-parameter type="specifier" description="The objects to be counted."/>
            <parameter name="each" code="kocl" type="type" optional="yes" hidden="yes" description="The class of objects to be counted.">
                <cocoa key="ObjectClass"/>
            </parameter>
            <result type="integer" description="The count."/>
        </command>
        <command name="copy diagnostics" code="WSpccpdg" description="Copy a summary of the current setup to the clipboard, and return it.">
            <cocoa class="WhichSpace.CopyDiagnosticsCommand"/>
            <result type="text" description="The diagnostics report."/>
        </command>
        <command name="export settings" code="WSpcexst" description="Export all settings and hotkeys to a JSON file, overwriting an existing file.">
            <cocoa class="WhichSpace.ExportSettingsCommand"/>
            <parameter name="to" code="dstf" type="file" description="The destination file. Its parent folder must exist.">
                <cocoa key="destination"/>
            </parameter>
        </command>
        <command name="import settings" code="WSpcimst" description="Restore all settings and hotkeys from a JSON backup.">
            <cocoa class="WhichSpace.ImportSettingsCommand"/>
            <parameter name="from" code="srcf" type="file" description="The existing JSON backup file.">
                <cocoa key="source"/>
            </parameter>
        </command>
        <command name="move front window left" code="WSpcmvlf" description="Move the frontmost window to the Space on the left, and switch to it.">
            <cocoa class="WhichSpace.MoveWindowLeftCommand"/>
        </command>
        <command name="move front window right" code="WSpcmvrt" description="Move the frontmost window to the Space on the right, and switch to it.">
            <cocoa class="WhichSpace.MoveWindowRightCommand"/>
        </command>
        <command name="move front window to space number" code="WSpcmvsp" description="Move the frontmost window to a Space by number, and switch to it. Numbering follows the menu bar&apos;s local or global preference.">
            <cocoa class="WhichSpace.MoveWindowToSpaceCommand"/>
            <direct-parameter type="integer" description="The Space number to move the window to (1-based)."/>
        </command>
        <command name="reset" code="WSpcrsps" description="Reset every customization of a Space so it follows the shared or default style again, as the Reset button in Settings does.">
            <direct-parameter type="space" description="The Space to reset, e.g. space 3, space 2 of display 2, or current space."/>
        </command>
        <command name="reset all space badges" code="WSpcrsab" description="Reset the badges of all Spaces on every display to their defaults.">
            <cocoa class="WhichSpace.ResetAllSpaceBadgesCommand"/>
        </command>
        <command name="reset all space labels" code="WSpcrsal" description="Reset the labels of all Spaces on every display to their defaults.">
            <cocoa class="WhichSpace.ResetAllSpaceLabelsCommand"/>
        </command>
        <command name="reset color" code="WSpcrscl" description="Reset the colors of a Space so it follows the shared or default style again.">
            <cocoa class="WhichSpace.ResetSpaceColorsCommand"/>
            <parameter name="for" code="rsfr" type="space" description="The Space to reset, e.g. space 3, space 2 of display 2, or current space.">
                <cocoa key="target"/>
            </parameter>
        </command>
        <command name="reset icon" code="WSpcrsic" description="Reset the symbol or emoji of a Space so it follows the shared or default style again.">
            <cocoa class="WhichSpace.ResetSpaceIconCommand"/>
            <parameter name="for" code="rsfr" type="space" description="The Space to reset, e.g. space 3, space 2 of display 2, or current space.">
                <cocoa key="target"/>
            </parameter>
        </command>
        <command name="send front window left" code="WSpcsdlf" description="Send the frontmost window to the Space on the left, without switching Space.">
            <cocoa class="WhichSpace.SendWindowLeftCommand"/>
        </command>
        <command name="send front window right" code="WSpcsdrt" description="Send the frontmost window to the Space on the right, without switching Space.">
            <cocoa class="WhichSpace.SendWindowRightCommand"/>
        </command>
        <command name="send front window to space number" code="WSpcsdsp" description="Send the frontmost window to a Space by number, without switching Space. Numbering follows the menu bar&apos;s local or global preference.">
            <cocoa class="WhichSpace.SendWindowToSpaceCommand"/>
            <direct-parameter type="integer" description="The Space number to send the window to (1-based)."/>
        </command>
        <command name="switch left" code="WSpcswlf" description="Switch to the Space on the left.">
            <cocoa class="WhichSpace.SwitchLeftCommand"/>
        </command>
        <command name="switch right" code="WSpcswrt" description="Switch to the Space on the right.">
            <cocoa class="WhichSpace.SwitchRightCommand"/>
        </command>
        <command name="switch to previous space" code="WSpcswpv" description="Switch back to the Space last visited on the current display.">
            <cocoa class="WhichSpace.SwitchToPreviousSpaceCommand"/>
        </command>
        <command name="switch to space number" code="WSpcswsp" description="Switch to a Space by number. Numbering follows the menu bar&apos;s local or global preference; global numbering addresses at most 16 Desktops, matching macOS&apos;s numbered Mission Control shortcuts.">
            <cocoa class="WhichSpace.SwitchToSpaceCommand"/>
            <direct-parameter type="integer" description="The Space number to switch to (1-based)."/>
            <parameter name="label" code="swlb" type="text" optional="yes" description="A custom label to apply to the Space.">
                <cocoa key="label"/>
            </parameter>
            <parameter name="badge" code="swbd" type="text" optional="yes" description="A badge character to apply to the Space (# shows the Space number).">
                <cocoa key="badge"/>
            </parameter>
        </command>
        <class name="application" code="capp" description="The WhichSpace application.">
            <cocoa class="NSApplication"/>
            <element type="display" access="r">
                <cocoa key="scriptableDisplays"/>
            </element>
            <element type="space" access="r">
                <cocoa key="scriptableSpaces"/>
            </element>
            <property name="current space" code="WScs" type="space" access="r" description="The current Space on the current display.">
                <cocoa key="currentScriptableSpace"/>
            </property>
            <property name="current space number" code="cusn" type="integer" access="r" description="The current Space number, following the local or global numbering preference.">
                <cocoa key="currentSpaceNumber"/>
            </property>
        </class>
        <class name="display" code="WSdc" plural="displays" description="A display. Ordered to match the display picker in WhichSpace settings.">
            <cocoa class="WhichSpace.ScriptableDisplay"/>
            <element type="space" access="r">
                <cocoa key="scriptableSpaces"/>
            </element>
            <property name="index" code="pidx" type="integer" access="r" description="The 1-based position of the display.">
                <cocoa key="displayNumber"/>
            </property>
            <property name="name" code="pnam" type="text" access="r" description="The localized display name, or an empty string when no attached screen matches.">
                <cocoa key="name"/>
            </property>
        </class>
        <class name="space" code="WSsc" plural="spaces" description="A Space on a display, counting fullscreen apps. `space N` addresses the current display; `space N of display M` addresses another display. Positions are fixed per display, unaffected by the local or global numbering preference.">
            <cocoa class="WhichSpace.ScriptableSpace"/>
            <property name="index" code="pidx" type="integer" access="r" description="The 1-based position of the Space on its display, counting fullscreen Spaces.">
                <cocoa key="spaceNumber"/>
            </property>
            <property name="label" code="WSlb" type="text" access="rw" description="The Space label as shown in the menu bar. Set a non-empty string to apply a custom label; set an empty string to reset it to the default.">
                <cocoa key="label"/>
            </property>
            <property name="badge" code="WSbd" type="text" access="rw" description="The Space badge character, or an empty string when none. Set a single character to apply a badge (# shows the Space number); an empty string resets it.">
                <cocoa key="badge"/>
            </property>
            <property name="symbol" code="WSsy" type="text" access="rw" description="The SF Symbol name shown instead of the Space number, or an empty string when the Space shows an emoji or no symbol. Set a symbol name to apply it; an empty string removes the icon. Use reset icon to follow the shared or default style again.">
                <cocoa key="symbol"/>
            </property>
            <property name="emoji" code="WSem" type="text" access="rw" description="The emoji shown instead of the Space number, or an empty string when the Space shows a symbol or no emoji. Set a single emoji to apply it; an empty string removes the icon. Use reset icon to follow the shared or default style again.">
                <cocoa key="emoji"/>
            </property>
            <property name="foreground color" code="WSfg" type="text" access="rw" description="The foreground color as RRGGBB, or RRGGBBAA when translucent, or an empty string when no colors are configured for the Space, shared, or as the default style. Setting one of foreground or background keeps the other configured color, or fills it from the current appearance when none is configured. Use reset color to clear all colors of a Space.">
                <cocoa key="foregroundColor"/>
            </property>
            <property name="background color" code="WSbg" type="text" access="rw" description="The background color as RRGGBB, or RRGGBBAA when translucent, or an empty string when no colors are configured for the Space, shared, or as the default style. Setting one of foreground or background keeps the other configured color, or fills it from the current appearance when none is configured. Use reset color to clear all colors of a Space.">
                <cocoa key="backgroundColor"/>
            </property>
            <property name="symbol color" code="WSyc" type="text" access="rw" description="The symbol color as RRGGBB, or RRGGBBAA when translucent, or an empty string while the symbol follows the foreground color. Set an empty string to follow the foreground color again.">
                <cocoa key="symbolColor"/>
            </property>
            <property name="symbol background color" code="WSyb" type="text" access="rw" description="The symbol background color as RRGGBB, or RRGGBBAA when translucent, or an empty string while the symbol has no background. Set an empty string to remove the background.">
                <cocoa key="symbolBackgroundColor"/>
            </property>
            <responds-to command="reset">
                <cocoa method="handleResetScriptCommand:"/>
            </responds-to>
        </class>
    </suite>
</dictionary>
